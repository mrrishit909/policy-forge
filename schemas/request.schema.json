{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrrishit909/policy-forge/schemas/request.schema.json",
  "title": "Policy Forge run request",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshot", "rule_packs", "remediation", "as_of"],
  "properties": {
    "snapshot": {
      "description": "One committed synthetic configuration snapshot.",
      "enum": ["aws-baseline-2026-10", "aws-drifted-2026-10", "azure-lab-2026-10"]
    },
    "rule_packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["storage", "iam", "network", "audit", "relationships"]}
    },
    "remediation": {
      "description": "none evaluates only; propose also writes local-file patches and re-verifies them.",
      "enum": ["none", "propose"]
    },
    "as_of": {
      "description": "Date exceptions are evaluated against (YYYY-MM-DD).",
      "type": "string",
      "pattern": "^20[2-3][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    }
  }
}
